---
import Layout from '../layouts/Layout.astro';
import { Explorer } from '../components/canvas/Explorer';
import { LABS, LABS_BY_VALUATION } from '../data/labs';
import { buildBasemap } from '../lib/basemap';

// Projected map + path data are computed at build time, so d3-geo and the
// world topojson never reach the browser.
const basemap = buildBasemap();

const description =
  'An interactive map of AI neolabs — sized by valuation and grouped by lineage, geography, and research area.';

// The table is a view of this page rather than a page of its own, so the
// crawlable inventory of every lab is rendered here — the explorer always
// mounts the table and CSS hides it away from ?view=table. Both the dataset and
// the list it contains are described for crawlers.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'AI Neolabs',
    description,
    url: 'https://neolabs.fyi/',
    distribution: { '@type': 'DataDownload', contentUrl: 'https://neolabs.fyi/?view=table' },
    variableMeasured: [
      'valuation',
      'founding year',
      'research area',
      'founder lineage',
      'headquarters',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'AI Neolabs by valuation',
    numberOfItems: LABS.length,
    itemListElement: LABS_BY_VALUATION.map((lab, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://neolabs.fyi/labs/${lab.slug}`,
      name: lab.name,
    })),
  },
];
---

<Layout
  title="Neolabs.fyi | Neolab research areas"
  description={description}
  path="/"
  jsonLd={jsonLd}
  bare
>
  <Explorer client:load labs={LABS} basemap={basemap} />
</Layout>
