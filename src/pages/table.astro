---
import Layout from '../layouts/Layout.astro';
import { LABS_BY_VALUATION, LABS } from '../data/labs';
import { LINEAGE_GROUPS, ORGS } from '../data/taxonomy';
import { TableControls } from '../components/table/TableControls';
import { valuationStep } from '../lib/color';
import { founderNames, spaceLabel, valuationLabel } from '../lib/format';
import { lineageGroupsOf } from '../lib/layout';

const description = `All ${LABS.length} AI neolabs in a sortable table: valuation, founding year, research area, founders and their prior labs, and headquarters.`;

const rows = LABS_BY_VALUATION.map((lab) => ({
  lab,
  step: valuationStep(lab.valuation.usdM),
  lineage: lineageGroupsOf(lab)
    .map((g) => LINEAGE_GROUPS[g].short)
    .join(', '),
  priors: [...new Set(lab.founders.flatMap((f) => f.prior ?? []).map((o) => ORGS[o].label))].join(
    ', '
  ),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI Neolabs by valuation',
  numberOfItems: LABS.length,
  itemListElement: LABS_BY_VALUATION.map((lab, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://neolabs.fyi/labs/${lab.slug}`,
    name: lab.name,
  })),
};
---

<Layout
  title="Neolabs.fyi | Neolab research areas, size and other info"
  description={description}
  path="/table"
  jsonLd={jsonLd}
>
  <Fragment slot="header-tools">
    <TableControls client:load labs={LABS} />
  </Fragment>

  <div class="table-wrap">
    <div class="table-scroll">
      <table class="labs" id="labs-table">
        <thead>
          <tr>
            <th scope="col"><button type="button" data-sort="name" data-type="text">Company</button></th>
            <th scope="col"><button type="button" data-sort="val" data-type="num">Valuation</button></th>
            <th scope="col"><button type="button" data-sort="year" data-type="num">Founded</button></th>
            <th scope="col"><button type="button" data-sort="space" data-type="text">Research area</button></th>
            <th scope="col"><button type="button" data-sort="lineage" data-type="text">Came out of</button></th>
            <th scope="col">Founders</th>
            <th scope="col"><button type="button" data-sort="place" data-type="text">Based in</button></th>
            <th scope="col">Known for</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr
                data-name={r.lab.name}
                data-val={r.lab.valuation.usdM}
                data-year={r.lab.year}
                data-space={spaceLabel(r.lab)}
                data-lineage={r.lineage}
                data-place={`${r.lab.location.country} ${r.lab.location.city}`}
                data-slug={r.lab.slug}
              >
                <td class="name">
                  <span
                    class="swatch"
                    style={`background:${
                      r.lab.valuation.qualifier === 'undisclosed' || r.lab.structure
                        ? 'var(--unknown-fill)'
                        : `var(--seq-${r.step})`
                    }`}
                    aria-hidden="true"
                  />
                  <a href={`/labs/${r.lab.slug}`}>{r.lab.name}</a>
                </td>
                <td class="num">
                  {valuationLabel(r.lab.valuation)}
                  {r.lab.valuation.rumored && <span class="muted" title="Rumored"> *</span>}
                </td>
                <td class="num">{r.lab.year}</td>
                <td>{spaceLabel(r.lab)}</td>
                <td>{r.priors || <span class="muted">—</span>}</td>
                <td>{founderNames(r.lab)}</td>
                <td>
                  {r.lab.location.city}
                  <div class="muted" style="font-size:.75rem">{r.lab.location.country}</div>
                </td>
                <td>{r.lab.knownFor}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="table-empty" id="labs-empty" hidden>No labs match that search.</p>
  </div>
</Layout>

<script>
  // Sorting stays vanilla and progressive — the table is fully readable and
  // ordered without JS. Filtering lives in the TableControls island, which
  // shares its logic with the map so both mean the same thing.
  const table = document.getElementById('labs-table') as HTMLTableElement | null;
  if (table) {
    const tbody = table.tBodies[0];
    let sortKey = 'val';
    let descending = true;

    table.querySelectorAll<HTMLButtonElement>('button[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.sort!;
        const numeric = button.dataset.type === 'num';
        descending = key === sortKey ? !descending : true;
        sortKey = key;

        Array.from(tbody.rows)
          .sort((a, b) => {
            const av = a.dataset[key] ?? '';
            const bv = b.dataset[key] ?? '';
            const cmp = numeric ? Number(av) - Number(bv) : av.localeCompare(bv);
            return descending ? -cmp : cmp;
          })
          .forEach((row) => tbody.appendChild(row));

        table.querySelectorAll('th').forEach((th) => th.removeAttribute('aria-sort'));
        button.closest('th')?.setAttribute('aria-sort', descending ? 'descending' : 'ascending');
      });
    });
  }
</script>
