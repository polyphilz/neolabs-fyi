---
import Layout from '../../layouts/Layout.astro';
import { LABS } from '../../data/labs';
import { PEOPLE } from '../../data/people';
import { ORGS, STRUCTURE_LABEL } from '../../data/taxonomy';
import type { Lab } from '../../data/types';
import {
  founderNames,
  foundersByLastName,
  labValuationLabel,
  spaceLabel,
  valuationCaveat,
} from '../../lib/format';

export function getStaticPaths() {
  return LABS.map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}

interface Props {
  lab: Lab;
}

const { lab } = Astro.props;

const founders = foundersByLastName(lab);
const caveat = valuationCaveat(lab);

// The long-tail query is "<lab> valuation" / "who founded <lab>", so the
// description answers exactly that in the first sentence.
const valuationDescription =
  lab.structure === 'nonprofit'
    ? 'is a nonprofit without an applicable equity valuation'
    : `is valued at ${labValuationLabel(lab)}`;
const description = `${lab.name} ${valuationDescription}. Founded in ${
  lab.year
} by ${founderNames(lab)}, based in ${lab.location.city}. ${lab.knownFor}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: lab.name,
  description: lab.knownFor,
  foundingDate: String(lab.year),
  founder: founders.map((f) => ({ '@type': 'Person', name: PEOPLE[f.person].name })),
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: lab.location.city,
      addressCountry: lab.location.cc,
    },
  },
  url: `https://neolabs.fyi/labs/${lab.slug}`,
};
---

<Layout
  title={`neolabs.fyi | ${lab.name} information`}
  description={description}
  path={`/labs/${lab.slug}`}
  jsonLd={jsonLd}
>
  <article class="lab-page">
    <a class="backlink" href="/">← All neolabs</a>
    <h1>{lab.name}</h1>
    {lab.priorNames?.length && <p class="muted">Formerly {lab.priorNames.join(', ')}</p>}

    <div class="lab-valuation-block">
      <p class="lab-hero">{labValuationLabel(lab)}</p>
      <p class="lab-caveat">{caveat ?? 'Reported valuation'}</p>
    </div>

    <p class="lab-lede">{lab.knownFor}</p>

    <dl class="lab-facts">
      <div>
        <dt>Founded</dt>
        <dd>{lab.year}</dd>
      </div>
      <div>
        <dt>Research area</dt>
        <dd>{spaceLabel(lab)}</dd>
      </div>
      <div>
        <dt>Headquarters</dt>
        <dd>{lab.location.city}, {lab.location.country}</dd>
      </div>
      {
        lab.exit && (
          <div>
            <dt>Status</dt>
            <dd>
              {lab.exit.type === 'shutdown'
                ? 'Shut down'
                : lab.exit.absorbed
                  ? `Acquired by ${lab.exit.to}`
                  : `Partly acquihired by ${lab.exit.to}`}
            </dd>
          </div>
        )
      }
      {
        lab.structure && (
          <div>
            <dt>Structure</dt>
            <dd>{STRUCTURE_LABEL[lab.structure]}</dd>
          </div>
        )
      }
      {
        lab.status === 'public' && (
          <div>
            <dt>Status</dt>
            <dd>Publicly listed — figure is a market cap</dd>
          </div>
        )
      }
    </dl>

    <h2>Founders</h2>
    <ul>
      {
        founders.map((f) => (
          <li>
            <strong>{PEOPLE[f.person].name}</strong>
            {f.isBacker && <span class="muted"> (backer)</span>}
            {f.prior?.length ? <span class="muted"> — previously {f.prior.map((o) => ORGS[o].label).join(', ')}</span> : null}
          </li>
        ))
      }
    </ul>

    <p style="margin-top:2rem">
      <a class="backlink" href={`/?lab=${lab.slug}`}>See {lab.name} on the map →</a>
    </p>
  </article>
</Layout>
