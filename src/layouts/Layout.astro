---
import '../styles/global.css';
import { SiteHeader } from '../components/SiteHeader';

interface Props {
  title: string;
  description: string;
  /** Absolute path, e.g. "/labs/ssi". Used for canonical + og:url. */
  path: string;
  /** Optional JSON-LD object graph. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Drop the header and let the page own the whole viewport. The explorer
   * renders the same header itself, floating over its canvas.
  */
  bare?: boolean;
}

const { title, description, path, jsonLd, bare = false } = Astro.props;
const site = Astro.site ?? new URL('https://neolabs.fyi');
const canonical = new URL(path, site).href;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// Must be absolute — crawlers don't resolve relative URLs, and they don't run
// JS, so this has to be a real static file.
const ogImage = new URL('/og/cover.png', site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="neolabs.fyi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="Every AI neolab drawn as a circle, sized by valuation — Roze, Z.ai and DeepSeek dominating a dense pack of smaller labs."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/0xproto-wordmark.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@100..900&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body class={bare ? 'is-bare' : undefined}>
    {!bare && <SiteHeader currentPath={currentPath} />}

    <main>
      <slot />
    </main>

  </body>
</html>
